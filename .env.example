# Base de données (PostgreSQL — Supabase, Neon, ou PostgreSQL classique)
DATABASE_URL="postgresql://user:password@localhost:5432/prospection?schema=public"

# NextAuth
NEXTAUTH_SECRET="generer-avec: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Identifiants OAuth Google (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# Secret partagé pour sécuriser les appels aux routes cron (/api/cron/*)
CRON_SECRET="generer-avec: openssl rand -base64 32"
